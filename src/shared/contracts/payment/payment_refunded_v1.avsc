{
  "type": "record",
  "name": "PaymentRefunded",
  "namespace": "com.edcp.payment.events",
  "doc": "Reply when a Refund command completed. Topic `payment.events.refunded` (subject `payment.events.refunded-value`).",
  "fields": [
    { "name": "event_id", "type": "string" },
    { "name": "aggregate_id", "type": "string", "doc": "Refund id (Payment aggregate)." },
    { "name": "occurred_at", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "order_id", "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "refund_id", "type": "string" },
    { "name": "charge_id", "type": "string", "doc": "Original charge refunded." },
    { "name": "amount", "type": { "type": "bytes", "logicalType": "decimal", "precision": 14, "scale": 2 } },
    { "name": "currency", "type": "string", "default": "BRL" }
  ]
}