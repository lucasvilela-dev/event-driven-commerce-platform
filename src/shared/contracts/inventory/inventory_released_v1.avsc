{
  "type": "record",
  "name": "InventoryReleased",
  "namespace": "com.edcp.inventory.events",
  "doc": "Reply when a ReleaseReservation command completed. Topic `inventory.events.released` (subject `inventory.events.released-value`).",
  "fields": [
    { "name": "event_id", "type": "string" },
    { "name": "aggregate_id", "type": "string", "doc": "Reservation id released." },
    { "name": "occurred_at", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "order_id", "type": "string" },
    { "name": "correlation_id", "type": "string" },
    { "name": "reservation_id", "type": "string" },
    { "name": "reason", "type": "string", "default": "saga_compensation" }
  ]
}