{
  "type": "record",
  "name": "ProductPriceUpdated",
  "namespace": "com.edcp.product.events",
  "doc": "Published when a Product's price is updated via the UpdatePrice command. Topic `product.events.price-updated` (subject `product.events.price-updated-value`).",
  "fields": [
    { "name": "event_id", "type": "string", "doc": "UUIDv7, idempotency key (ADR-009)." },
    { "name": "aggregate_id", "type": "string", "doc": "Product id." },
    { "name": "occurred_at", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "price", "type": { "type": "bytes", "logicalType": "decimal", "precision": 14, "scale": 2 }, "doc": "New unit price." },
    { "name": "currency", "type": "string", "default": "BRL", "doc": "Currency of the new price (may change)." }
  ]
}